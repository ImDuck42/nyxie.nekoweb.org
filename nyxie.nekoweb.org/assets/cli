# -- MAIN FUNCTIONS ------------------------------------------------------------
free_port() {
  local pids
  local port="$1"
  if command -v lsof >/dev/null 2>&1; then
    pids=$(lsof -ti TCP:"$port" -sTCP:LISTEN 2>/dev/null)
    if [ -n "$pids" ]; then
      ui_box_row "[!]" "$MOCHA_YELLOW" "Port $port in use" "[ Reclaiming ]" "$MOCHA_RED"
      kill -9 $pids 2>/dev/null || true
      sleep 0.5
    fi
  fi
}

quick_start() {
  local target_dir=$(resolve_path "$1")

  printf "\n"
  printf "  ${MOCHA_MAUVE}${CLR_BOLD}[>] Initializing Launch Sequence${CLR_RESET}\n"
  printf "  ${MOCHA_OVERLAY}╭────────────────────────────────────────────────────────────────╮${CLR_RESET}\n"

  free_port "$HTTP_PORT"
  free_port "$HTTPS_PORT"

  if [ ! -f "${target_dir}/server.py" ]; then
    ui_box_row "[*]" "$MOCHA_YELLOW" "Server file" "[ Downloading ]" "$MOCHA_YELLOW"
    
    if perform_download "$target_dir"; then
      ui_box_row "[*]" "$MOCHA_GREEN" "Server file" "[ Installed ]" "$MOCHA_GREEN"
    else
      ui_box_row "[!]" "$MOCHA_RED" "Server file" "[ Failed ]" "$MOCHA_RED"
      printf "  ${MOCHA_OVERLAY}╰────────────────────────────────────────────────────────────────╯${CLR_RESET}\n\n"
      return 1
    fi
  else
    perform_download "$target_dir"
    ui_box_row "[*]" "$MOCHA_GREEN" "Server file" "[ Updated ]" "$MOCHA_GREEN"
  fi

  PY_CMD=$(get_python_cmd)
  if [ -z "$PY_CMD" ]; then
    ui_box_row "[!]" "$MOCHA_RED" "Python Runtime" "[ Not Found ]" "$MOCHA_RED"
    printf "  ${MOCHA_OVERLAY}╰────────────────────────────────────────────────────────────────╯${CLR_RESET}\n\n"
    return 1
  else
    ui_box_row "[*]" "$MOCHA_GREEN" "Python Runtime" "[ $PY_CMD ]" "$MOCHA_GREEN"
  fi

  ui_box_row "[*]" "$MOCHA_LAVENDER" "Web Client" "[ Opening ]" "$MOCHA_LAVENDER"
  open_url "$SITE_URL"

  local local_ip="${HOST:-$(get_local_ip)}"
	local http_route="http://${local_ip}:${HTTP_PORT}"
	local https_route="https://${local_ip}:${HTTPS_PORT}"

  printf "  ${MOCHA_OVERLAY}├────────────────────────────────────────────────────────────────┤${CLR_RESET}\n"
  
  ui_info_row ":::" "$MOCHA_PEACH" "Serving Path" "$target_dir" "$MOCHA_YELLOW"
  ui_info_row ":::" "$MOCHA_GREEN" "HTTP  Route"  "$http_route" "$MOCHA_SAPPHIRE"
  ui_info_row ":::" "$MOCHA_GREEN" "HTTPS Route" "$https_route" "$MOCHA_SAPPHIRE"


  printf "  ${MOCHA_OVERLAY}│${CLR_RESET}  ${MOCHA_OVERLAY}${CLR_BOLD}(i)${CLR_RESET}  Press ${MOCHA_RED}Ctrl + C${CLR_RESET} at any time to return to menu.            ${MOCHA_OVERLAY}│${CLR_RESET}\n"
  printf "  ${MOCHA_OVERLAY}╰────────────────────────────────────────────────────────────────╯${CLR_RESET}\n\n"
  
  trap ':' INT
  (cd "$target_dir" && "$PY_CMD" server.py "$target_dir" "$HTTP_PORT" "$HTTPS_PORT")
  trap cleanup_and_exit INT

  printf "\n"
  printf "  ${MOCHA_YELLOW}${CLR_BOLD}[-]${CLR_RESET} Server stopped.\n"
  printf "  ${MOCHA_SUBTEXT}Press ${CLR_BOLD}[Enter]${CLR_RESET}${MOCHA_SUBTEXT} to return to menu...${CLR_RESET}"
  tty_read
}

download_server() {
  local target_dir=$(resolve_path "$1")

  printf "\n"
  printf "  ${MOCHA_MAUVE}${CLR_BOLD}[>] Download Sequence${CLR_RESET}\n"
  printf "  ${MOCHA_OVERLAY}╭────────────────────────────────────────────────────────────────╮${CLR_RESET}\n"
  
  ui_box_row "[*]" "$MOCHA_YELLOW" "Target Path" "[ $target_dir ]" "$MOCHA_YELLOW"
  ui_box_row "[*]" "$MOCHA_BLUE"   "Server file" "[ Downloading ]" "$MOCHA_BLUE"
  
  if perform_download "$target_dir" && [ -f "${target_dir}/server.py" ]; then
    ui_box_row "[*]" "$MOCHA_GREEN" "Server file" "[ Installed ]" "$MOCHA_GREEN"
  else
    ui_box_row "[!]" "$MOCHA_RED"   "Server file" "[ Failed ]"    "$MOCHA_RED"
  fi

  printf "  ${MOCHA_OVERLAY}╰────────────────────────────────────────────────────────────────╯${CLR_RESET}\n"
}

open_web_app() {
  printf "\n"
  printf "  ${MOCHA_MAUVE}${CLR_BOLD}[>] Website Launch Sequence${CLR_RESET}\n"
  printf "  ${MOCHA_OVERLAY}╭────────────────────────────────────────────────────────────────╮${CLR_RESET}\n"
  
  ui_box_row "[*]" "$MOCHA_LAVENDER" "Target URL" "[ $SITE_URL ]" "$MOCHA_LAVENDER"
  ui_box_row "[*]" "$MOCHA_GREEN"    "Web Client" "[ Opening ]"   "$MOCHA_GREEN"
  
  printf "  ${MOCHA_OVERLAY}╰────────────────────────────────────────────────────────────────╯${CLR_RESET}\n"
  
  open_url "$SITE_URL"
}

show_help() {
  print_banner
  printf "  ${MOCHA_MAUVE}${CLR_BOLD}Usage:${CLR_RESET}\n"
  printf "    ${MOCHA_GREEN}curl https://nyxie.nekoweb.org | bash ${CLR_RESET}\n"
  printf "    ${MOCHA_GREEN}curl https://nyxie.nekoweb.org | bash${CLR_RESET} ${MOCHA_TEAL}-s -- [OPTION]${CLR_RESET} ${MOCHA_PEACH}[ARGUMENT]${CLR_RESET}\n\n"
  printf "  ${MOCHA_MAUVE}${CLR_BOLD}Options:${CLR_RESET}\n"
  printf "    ${MOCHA_TEAL}-s, --start    ${MOCHA_PEACH}[path]${CLR_RESET}  ${MOCHA_TEXT}Start server in ${MOCHA_PEACH}[path]${MOCHA_TEXT} (or ./) & open site${CLR_RESET}\n"
  printf "    ${MOCHA_TEAL}-d, --download ${MOCHA_PEACH}[path]${CLR_RESET}  ${MOCHA_TEXT}Download server.py into ${MOCHA_PEACH}[path]${MOCHA_TEXT} (or ./)${CLR_RESET}\n"
  printf "    ${MOCHA_TEAL}-o, --open${CLR_RESET}             ${MOCHA_TEXT}Open Gallery website in default browser${CLR_RESET}\n"
  printf "    ${MOCHA_TEAL}-h, --help${CLR_RESET}             ${MOCHA_TEXT}Show this help message${CLR_RESET}"
}

# -- ARGUMENTS & MENU ----------------------------------------------------------
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -s|--start)
        local target="."
        if [[ -n "$2" && "$2" != -* ]]; then target="$2"; shift; fi
        quick_start "$target"
        exit 0 ;;
      -d|--download)
        local target="."
        if [[ -n "$2" && "$2" != -* ]]; then target="$2"; shift; fi
        download_server "$target"
        exit 0 ;;
      -o|--open)
        open_web_app
        exit 0 ;;
      -h|--help)
        show_help
        exit 0 ;;
      *)
        printf "  ${MOCHA_RED}[!] Unknown parameter: %s${CLR_RESET}\n" "$1"
        show_help
        exit 1 ;;
    esac
    shift
  done
}

main_menu() {
  while true; do
    print_banner
    
    ui_menu_header "Actions"
    ui_menu_row "1" "$MOCHA_MAUVE"    "Quick Start"     "Launch server & open gallery"   "[path]"  "$MOCHA_OVERLAY"
    ui_menu_row "2" "$MOCHA_BLUE"     "Download Server" "Save server.py to local folder" "[path]"  "$MOCHA_OVERLAY"
    ui_menu_row "3" "$MOCHA_SAPPHIRE" "Open Website"    "Launch browser interface"       " /\_/\ "  "$MOCHA_PEACH"
    ui_menu_row "0" "$MOCHA_RED"      "Exit"            "Close CLI launcher"             "(=^.^=)"  "$MOCHA_PEACH" "$MOCHA_SUBTEXT"
    ui_menu_footer

    printf "  ${MOCHA_MAUVE}╭─[${MOCHA_LAVENDER} gallery@$(pwd) ${MOCHA_MAUVE}]${CLR_RESET}\n"
    printf "  ${MOCHA_MAUVE}╰─${MOCHA_PEACH}❯${MOCHA_YELLOW}❯${MOCHA_GREEN}❯ ${MOCHA_TEXT}Select [0-3]: ${CLR_RESET}"
    
    tty_read raw_input

    local choice=$(printf "%s\n" "$raw_input" | awk '{print $1}')
    local arg=$(printf "%s\n" "$raw_input" | cut -d' ' -f2-)
    [ "$choice" = "$arg" ] && arg=""

    case "$choice" in
      1)
        quick_start "$arg" ;;
      2)
        download_server "$arg"
        printf "  ${MOCHA_SUBTEXT}Press ${CLR_BOLD}[Enter]${CLR_RESET}${MOCHA_SUBTEXT} to continue...${CLR_RESET}"
        tty_read ;;
      3)
        open_web_app
        printf "  ${MOCHA_SUBTEXT}Press ${CLR_BOLD}[Enter]${CLR_RESET}${MOCHA_SUBTEXT} to continue...${CLR_RESET}"
        tty_read ;;
      0|q|Q|exit)
        cleanup_and_exit ;;
      *)
        printf "\n"
        printf "  ${MOCHA_RED}${CLR_BOLD}[!]${CLR_RESET}${MOCHA_RED} Invalid selection, please try again.${CLR_RESET}\n"
        sleep 1 ;;
    esac
  done
}

# -- ENTRY POINT ---------------------------------------------------------------
init_colors
if [ $# -gt 0 ]; then
  parse_args "$@"
else
  main_menu
fi