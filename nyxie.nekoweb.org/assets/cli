# -- CONFIGURATION -------------------------------------------------------------
HTTP_PORT="${HTTP_PORT:-${PORT:-4269}}"
HTTPS_PORT="${HTTPS_PORT:-4270}"
HOST="${HOST:-}"

SITE_URL="https://nyxie.nekoweb.org"
SERVER_PY="https://nyxie.nekoweb.org/server.py"

# -- STYLING & COLORS ----------------------------------------------------------
init_colors() {
  ESC=$'\033'
  CLR_RESET="${ESC}[0m"
  CLR_BOLD="${ESC}[1m"
  CLR_DIM="${ESC}[2m"

  # Catppuccin Mocha Colors
  MOCHA_ROSEWATER="${ESC}[38;2;245;224;220m" #f5e0dc
  MOCHA_FLAMINGO="${ESC}[38;2;242;205;205m"  #f2cdcd
  MOCHA_PINK="${ESC}[38;2;245;194;231m"      #f5c2e7
  MOCHA_MAUVE="${ESC}[38;2;203;166;247m"     #cba6f7
  MOCHA_RED="${ESC}[38;2;243;139;168m"       #f38ba8
  MOCHA_PEACH="${ESC}[38;2;250;179;135m"     #fab387
  MOCHA_YELLOW="${ESC}[38;2;249;226;175m"    #f9e2af
  MOCHA_GREEN="${ESC}[38;2;166;227;161m"     #a6e3a1
  MOCHA_TEAL="${ESC}[38;2;148;226;213m"      #94e2d5
  MOCHA_SKY="${ESC}[38;2;137;220;235m"       #89dceb
  MOCHA_SAPPHIRE="${ESC}[38;2;116;199;236m"  #74c7ec
  MOCHA_BLUE="${ESC}[38;2;137;180;250m"      #89b4fa
  MOCHA_LAVENDER="${ESC}[38;2;180;190;254m"  #b4befe
  MOCHA_TEXT="${ESC}[38;2;205;214;244m"      #cdd6f4
  MOCHA_SUBTEXT="${ESC}[38;2;166;173;200m"   #a6adc8
  MOCHA_OVERLAY="${ESC}[38;2;108;112;134m"   #6c7086
}

# -- MAIN UTILITIES ------------------------------------------------------------
cleanup_and_exit() {
  printf "\n\n"
  printf "  ${MOCHA_PEACH}${CLR_BOLD} /\_/\  ${MOCHA_LAVENDER}Byee!${CLR_RESET}\n"
  printf "  ${MOCHA_PEACH}${CLR_BOLD}(=^.^=) ${MOCHA_LAVENDER}See you next time${CLR_RESET}\n"
  exit 0
}
trap cleanup_and_exit INT

tty_read() {
  if [ -e /dev/tty ]; then read -r "$@" < /dev/tty; else read -r "$@"; fi
}

resolve_path() {
  local target="$1"
  if [ -z "$target" ]; then
    printf "%s\n" "$PWD"
    return
  fi
  
  target="${target/#\~/$HOME}"
  mkdir -p "$target" 2>/dev/null
  
  if [ -d "$target" ]; then
    (cd "$target" && pwd)
  else
    printf "%s\n" "$target"
  fi
}

get_python_cmd() {
  if   command -v python3 >/dev/null 2>&1; then printf "python3\n"
  elif command -v python  >/dev/null 2>&1; then printf "python\n"
  else printf "\n"; fi
}

get_local_ip() {
  local ip=""
  if [ -z "$ip" ] && command -v ip >/dev/null 2>&1; then
    ip=$(ip route get 8.8.8.8 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}')
  fi
  if [ -z "$ip" ] && command -v ipconfig >/dev/null 2>&1 && command -v route >/dev/null 2>&1; then
    local iface
    iface=$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')
    if [ -n "$iface" ]; then
      ip=$(ipconfig getifaddr "$iface" 2>/dev/null)
    fi
  fi
  
  if [ -z "$ip" ]; then
    ip="127.0.0.1"
  fi

  printf "%s\n" "$ip"
}

open_url() {
  local url="$1"
  if   command -v open     >/dev/null 2>&1; then open     "$url" >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 &
  elif command -v python3  >/dev/null 2>&1; then python3  -m webbrowser "$url" >/dev/null 2>&1 &
  elif command -v python   >/dev/null 2>&1; then python   -m webbrowser "$url" >/dev/null 2>&1 &
  fi
}

perform_download() {
  local target_dir="$1"
  if command -v curl >/dev/null 2>&1; then
    curl -sSL "$SERVER_PY" -o "${target_dir}/server.py"
    return $?
  fi
  return 1
}

# -- USER INTERFACE ------------------------------------------------------------
# Generates a dynamic dot-padded row: │  [*]  Server ............... [ OK ]  │
ui_box_row() {
  local icon="$1" iclr="$2" label="$3" bracket="$4" bclr="$5"
  
  local border="${MOCHA_OVERLAY}│${CLR_RESET}"
  local styled_icon="${iclr}${CLR_BOLD}${icon}${CLR_RESET}"
  local styled_bracket="${bclr}${bracket}${CLR_RESET}"
  
  local max_len=55
  local content_len=$((${#label} + ${#bracket} + 2))
  local dots=""
  
  if [[ $((max_len - content_len)) -gt 0 ]]; then
    local spaces=$(printf "%$((max_len - content_len))s" "")
    dots="${spaces// /.}"
  fi

  printf "  %s  %s  %s ${MOCHA_OVERLAY}%s${CLR_RESET} %s  %s\n" \
    "$border" "$styled_icon" "$label" "$dots" "$styled_bracket" "$border"
}

# Generates an info-padded row: │  :::  Path         /var/www/dir      │
ui_info_row() {
  local icon="$1" iclr="$2" label="$3" value="$4" vclr="$5"
  
  local border="${MOCHA_OVERLAY}│${CLR_RESET}"
  local styled_icon="${iclr}${CLR_BOLD}${icon}${CLR_RESET}"
  
  printf "  %s  %s  %-15s${vclr}%-40.40s${CLR_RESET}  %s\n" \
    "$border" "$styled_icon" "$label" "$value" "$border"
}

# Prints the top border of the menu
ui_menu_header() {
  local title="$1"
  local inner_width=${2:-64}
  
  local title_str="── ${title} "
  local fill_len=$(( inner_width - ${#title_str} ))
  local spaces=$(printf "%${fill_len}s" "")
  local dashes="${spaces// /─}"
  
  printf "  ${MOCHA_OVERLAY}╭%s%s╮${CLR_RESET}\n" "$title_str" "$dashes"
}

# Prints a menu row with calculated padding
ui_menu_row() {
  local idx="$1" idx_clr="$2" title="$3" desc="$4" extra="$5" extra_clr="$6"
  local title_style="${7:-$CLR_BOLD}" # Defaults to Bold if not provided
  local inner_width=${8:-64}
  local title_width=${9:-17}          # Space reserved for the title column

  # Formatting with colors
  local border="${MOCHA_OVERLAY}│${CLR_RESET}"
  local c_idx="${idx_clr}${CLR_BOLD}[${idx}]${CLR_RESET}"
  local c_title="${title_style}${title}${CLR_RESET}"
  local c_desc="${MOCHA_SUBTEXT}${desc}${CLR_RESET}"
  local c_extra="${extra_clr}${extra}${CLR_RESET}"

  # Padding after the title (aligns the descriptions)
  local pad_title_len=$(( title_width - ${#title} ))
  [[ $pad_title_len -lt 1 ]] && pad_title_len=1
  local pad_title=$(printf "%${pad_title_len}s" "")

  # Padding after the description (right-aligns the extra info)
  # 9 = 2 (left gap) + 3 (idx size) + 2 (gap) + 2 (right gap)
  local current_len=$(( 9 + ${#title} + pad_title_len + ${#desc} ))
  local pad_desc_len=$(( inner_width - current_len - ${#extra} ))
  [[ $pad_desc_len -lt 1 ]] && pad_desc_len=1
  local pad_desc=$(printf "%${pad_desc_len}s" "")

  # printf to build the spaced row
  printf "  %s  %s  %s%s%s%s%s  %s\n" \
    "${border}" "${c_idx}" "${c_title}" "${pad_title}" "${c_desc}" "${pad_desc}" "${c_extra}" "${border}"
}

# Prints the bottom border of the menu
ui_menu_footer() {
  local inner_width=${1:-64}
  local spaces=$(printf "%${inner_width}s" "")
  local dashes="${spaces// /─}"
  
  printf "  ${MOCHA_OVERLAY}╰%s╯${CLR_RESET}\n" "$dashes"
}

